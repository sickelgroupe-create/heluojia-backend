# Copy to /opt/meir-shop/application-server.properties; values come from server.env.
server.address=127.0.0.1
server.port=${SERVER_PORT:18080}
spring.datasource.druid.master.url=jdbc:mysql://${DB_HOST:127.0.0.1}:${DB_PORT:3306}/${DB_NAME:meir_shop}?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai
spring.datasource.druid.master.username=${DB_USER:meir_shop}
spring.datasource.druid.master.password=${DB_PASSWORD}
spring.datasource.druid.statViewServlet.enabled=false
spring.redis.host=${REDIS_HOST:127.0.0.1}
spring.redis.port=${REDIS_PORT:6379}
spring.redis.database=${REDIS_DATABASE:0}
spring.redis.password=${REDIS_PASSWORD:}
spring.devtools.restart.enabled=false
token.secret=${TOKEN_SECRET}
ruoyi.profile=/opt/meir-shop/runtime/profile
shop.asset-path=/opt/meir-shop/runtime/assets
shop.private-path=/opt/meir-shop/runtime/private
shop.demo=false
shop.test-data=false
shop.official-display=true
swagger.enabled=false
shop.wechat.only=true
shop.wechat.app-id=${WECHAT_APP_ID:}
shop.wechat.app-secret=${WECHAT_APP_SECRET:}
shop.wechat.code-version=${WECHAT_CODE_VERSION:trial}
shop.wechat-pay.enabled=${WECHAT_PAY_ENABLED:false}
shop.wechat-pay.mch-id=${WECHAT_MCH_ID:}
shop.wechat-pay.api-v3-key=${WECHAT_API_V3_KEY:}
shop.wechat-pay.public-key-id=${WECHAT_PAY_PUBLIC_KEY_ID:}
shop.wechat-pay.certificate-path=/opt/meir-shop/wechat-pay/apiclient_cert.pem
shop.wechat-pay.private-key-path=/opt/meir-shop/wechat-pay/apiclient_key.pem
shop.wechat-pay.public-key-path=/opt/meir-shop/wechat-pay/pub_key.pem
shop.wechat-pay.notify-url=${WECHAT_PAY_NOTIFY_URL:}
shop.backup.enabled=false
shop.backup.path=/opt/meir-shop/backups
shop.backup.mysqldump=/usr/bin/mysqldump
