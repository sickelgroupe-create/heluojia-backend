# systemd EnvironmentFile; keep outside Git and chmod 600. No 'export' prefix.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meir_shop
DB_USER=meir_shop
DB_PASSWORD=replace_with_database_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=replace_with_redis_password
TOKEN_SECRET=replace_with_random_64_character_secret
SHOP_LOG_PATH=/opt/meir-shop/runtime/logs
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CODE_VERSION=trial
WECHAT_PAY_ENABLED=false
WECHAT_MCH_ID=
WECHAT_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/shop/wechat-pay/notify
